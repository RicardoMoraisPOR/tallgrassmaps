{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 80,
  "sortImports": {
    "customGroups": [
      {
        "groupName": "react",
        "elementNamePattern": ["react", "react/**"]
      }
    ],
    "groups": [
      "react",
      ["builtin", "external"],
      "internal",
      ["parent", "sibling", "index"],
      "unknown"
    ]
  },
  "sortTailwindcss": {
    "stylesheet": "./src/index.css"
  },
  "sortPackageJson": false,
  "ignorePatterns": ["dist", "pnpm-lock.yaml"]
}
